## Polarion ALM Functional Trace Viewer (Apache Velocity Script)
## Works in Polarion ALM Rich Page / Script Widget / Classic Wiki Page

## Version Definition
#set($scriptVersion = "v1.0.2")

## Parameter Priority:
## 1. Direct URL query parameter (reqId) - entered via text box / Apply button
## 2. Rich Page parameter ($pageParameters.reqId) - set via page settings
#set($selectedReqId = "")
#if($request.getParameter("reqId") && $request.getParameter("reqId").trim() != "")
    #set($selectedReqId = $request.getParameter("reqId").trim())
#elseif($pageParameters && $pageParameters.get("reqId") && $pageParameters.get("reqId").value && $pageParameters.get("reqId").value.trim() != "")
    #set($selectedReqId = $pageParameters.get("reqId").value.trim())
#end

