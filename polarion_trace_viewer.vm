## Construct full trace URL
#set($generatedTraceUrl = "https://polarion.asml.com/polarion/#/project/0030/wiki/Report/Functional%20Traceability%20Analyzer?Title=${titleUrlParam}&WorkItems=${workItemsUrlParam}&Depth=${paramDepth}")

<script type="text/javascript">
// Extract URL parameters client-side and sync server-calculated Title into browser address bar URL
(function syncUrlTitle() {
    try {
        var serverTitle = "$!safeJsParamTitle";
        var targetWin = window.top || window;
        var href = targetWin.location.href;

        if (serverTitle && serverTitle !== "") {
            if (href.indexOf('Title=') !== -1) {
                // Replace Title= parameter if empty or different
                var newHref = href.replace(/([?&])Title=[^&]*/, '$1Title=' + encodeURIComponent(serverTitle));
                if (newHref !== href && targetWin.history && targetWin.history.replaceState) {
                    targetWin.history.replaceState(null, '', newHref);
                }
            }
        }
    } catch(err) {}
})();

function tvApplyTrace(e) {
    if (e && e.preventDefault) { e.preventDefault(); }

    var inputWorkItems = document.getElementById('tvReqInput');
    var inputTitle = document.getElementById('tvTitleInput');
    var inputDepth = document.getElementById('tvDepthInput');

    if (!inputWorkItems) return false;
    var valWorkItems = inputWorkItems.value.trim();
    if (!valWorkItems) return false;

    var valTitle = inputTitle ? inputTitle.value.trim() : "";
    var valDepth = inputDepth && inputDepth.value.trim() ? inputDepth.value.trim() : "6";

    var targetWin = window;
    try {
        if (window.top && window.top.location && window.top.location.href) {
            targetWin = window.top;
        }
    } catch(err) {}

    var href = targetWin.location.href;

    // Clean any existing query params before '#' to prevent 'polarion/?WorkItems=...#/' format
    if (href.indexOf('?') !== -1 && href.indexOf('#') !== -1 && href.indexOf('?') < href.indexOf('#')) {
        var preHash = href.substring(0, href.indexOf('?'));
        var hashPart = href.substring(href.indexOf('#'));
        href = preHash + hashPart;
    }

    // Extract base URL before query parameters in hash part
    var baseHashRoute = href;
    if (baseHashRoute.indexOf('?') !== -1) {
        baseHashRoute = baseHashRoute.substring(0, baseHashRoute.indexOf('?'));
    }

    // Always construct complete query string with Title, WorkItems, and Depth
    var queryParams = "Title=" + encodeURIComponent(valTitle) +
                      "&WorkItems=" + encodeURIComponent(valWorkItems) +
                      "&Depth=" + encodeURIComponent(valDepth);

    href = baseHashRoute + "?" + queryParams;

    targetWin.location.href = href;
    return false;
}

function tvCopyUrl() {
    var el = document.getElementById('tvGeneratedUrlText');
    if (el) {
        navigator.clipboard.writeText(el.innerText || el.textContent);
        alert('Generated Trace URL copied to clipboard!');
    }
}
</script>

<div class="polarion-trace-viewer">
    <!-- Header & Input Form -->
