<script type="text/javascript">
function tvApplyTrace(e) {
    if (e && e.preventDefault) { e.preventDefault(); }
    var input = document.getElementById('tvReqInput');
    if (!input) return false;
    var val = input.value.trim();
    if (!val) return false;

    var loc = window.location;
    try {
        if (window.top && window.top.location && window.top.location.href) {
            loc = window.top.location;
        }
    } catch(err) {}

    var href = loc.href;
    if (href.indexOf('reqId=') !== -1) {
        href = href.replace(/([?&])reqId=[^&]*/, '$1reqId=' + encodeURIComponent(val));
    } else {
        if (href.indexOf('#') !== -1) {
            var parts = href.split('#');
            var base = parts[0];
            var hash = parts.slice(1).join('#');
            var sep = base.indexOf('?') !== -1 ? '&' : '?';
            href = base + sep + 'reqId=' + encodeURIComponent(val) + '#' + hash;
        } else {
            var sep = href.indexOf('?') !== -1 ? '&' : '?';
            href = href + sep + 'reqId=' + encodeURIComponent(val);
        }
    }

    loc.href = href;
    return false;
}
</script>

