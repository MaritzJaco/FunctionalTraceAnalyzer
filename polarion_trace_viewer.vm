<script type="text/javascript">
function tvApplyTrace(e) {
    if (e && e.preventDefault) { e.preventDefault(); }
    var input = document.getElementById('tvReqInput');
    if (!input) return false;
    var val = input.value.trim();
    if (!val) return false;

    var loc = window.location;
    try {
        if (window.top && window.top.location && window.top.location.href) {
            loc = window.top.location;
        }
    } catch(err) {}

    var href = loc.href;
    if (href.indexOf('reqId=') !== -1) {
        href = href.replace(/([?&])reqId=[^&]*/, '$1reqId=' + encodeURIComponent(val));
    } else {
        if (href.indexOf('#') !== -1) {
            var parts = href.split('#');
            var base = parts[0];
            var hash = parts.slice(1).join('#');
            var sep = base.indexOf('?') !== -1 ? '&' : '?';
            href = base + sep + 'reqId=' + encodeURIComponent(val) + '#' + hash;
        } else {
            var sep = href.indexOf('?') !== -1 ? '&' : '?';
            href = href + sep + 'reqId=' + encodeURIComponent(val);
        }
    }

    loc.href = href;
    return false;
}
</script>

#set($currentProjId = "")
#if($page && $page.project && $page.project.id)
    #set($currentProjId = $page.project.id)
#elseif($project && $project.id)
    #set($currentProjId = $project.id)
#elseif($trackerService && $trackerService.trackerProject && $trackerService.trackerProject.id)
    #set($currentProjId = $trackerService.trackerProject.id)
#end

#if(!$currentProjId || $currentProjId == "")
    #set($currentProjId = "Global / Unassigned")
#end

<div class="polarion-trace-viewer">
    <!-- Header & Input Form -->
    <div class="tv-card">
        <div class="tv-header">
            <div class="tv-title">
                <span>🔗</span> Polarion Functional Trace Viewer
                <span class="tv-version-badge">$scriptVersion</span>
            </div>
            <div>
                <span class="tv-badge tv-badge-proj">Project: $!currentProjId</span>
            </div>
        </div>

        <form id="tvTraceForm" onsubmit="return tvApplyTrace(event);">
            <div class="tv-form-group">
                <label class="tv-label" for="tvReqInput">Enter Functional Requirement Work Item ID:</label>
                <div class="tv-input-row">
                    <input type="text" id="tvReqInput" name="reqId" class="tv-input-text"
                           value="$!selectedReqId"
                           placeholder="e.g. REQ-101, 0030-176, or FUNC-204" />
                    <button type="button" class="tv-btn tv-btn-primary" onclick="tvApplyTrace(event);">Apply</button>
                </div>
            </div>
        </form>
    </div>

    ## Process Trace if Requirement ID provided
    #if($selectedReqId && $selectedReqId != "")
        ## Search work item using Polarion Tracker Service
        #set($q = '"')
        #set($query = "id:" + $q + $selectedReqId + $q + " OR id:*" + $selectedReqId)
        #if($currentProjId && $currentProjId != "Global / Unassigned")
            #set($query = "project.id:" + $q + $currentProjId + $q + " AND (id:" + $q + $selectedReqId + $q + " OR id:*" + $selectedReqId + ")")
        #end

        #set($workItems = $trackerService.queryWorkItems($query, "id"))

        #if($workItems.isEmpty())
            <div class="tv-card" style="border-color:#fca5a5; background:#fef2f2;">
                <strong style="color:#dc2626;">⚠️ Work Item Not Found:</strong>
                No requirement found matching ID <code>$selectedReqId</code>#if($currentProjId && $currentProjId != "Global / Unassigned") in project <code>$currentProjId</code>#end.
            </div>
        #else
            #set($rootItem = $workItems.get(0))

            <div class="tv-card">
                <!-- Requirement Title Banner -->
                <div class="tv-req-banner">
                    <div class="tv-req-title">
                        Requirement: <span class="tv-item-id">$!rootItem.id</span> - $!rootItem.title
                    </div>
                    <div class="tv-req-meta">
                        Type: <strong>$!rootItem.type.name</strong> | Status: <strong>$!rootItem.status.name</strong> | Project: <strong>$!currentProjId</strong>
                    </div>
                </div>

                <!-- Linked Items -->
                <div style="font-weight: 700; font-size: 15px; margin-bottom: 10px; color: #0f172a;">
                    Linked Items / Traceability Results
                </div>

                #set($directLinks = $rootItem.linkedWorkItemsStructsDirect)
                #if($directLinks.isEmpty())
                    <p style="color: #64748b; font-style: italic;">No linked work items found for this requirement.</p>
                #else
                    <table class="tv-table">
                        <thead>
                            <tr>
                                <th>Linked Work Item ID</th>
                                <th>Relationship</th>
                                <th>Type</th>
                                <th>Title</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            #foreach($link in $directLinks)
                                #set($target = false)
                                #set($target = $link.linkedItem)
                                #if($target)
                                    #set($role = false)
                                    #set($role = $link.linkRole.name)
                                    <tr>
                                        <td><span class="tv-item-id">$!target.id</span></td>
                                        <td><span class="tv-rel">$!role</span></td>
                                        <td>$!target.type.name</td>
                                        <td>$!target.title</td>
                                        <td>$!target.status.name</td>
                                    </tr>
                                    ## Check sub-links (level 2)
                                    #foreach($subLink in $target.linkedWorkItemsStructsDirect)
                                        #set($subTarget = false)
                                        #set($subTarget = $subLink.linkedItem)
                                        #if($subTarget)
                                            #set($subRole = false)
                                            #set($subRole = $subLink.linkRole.name)
                                            <tr style="background:#f8fafc;">
                                                <td style="padding-left: 20px;">↳ <span class="tv-item-id">$!subTarget.id</span></td>
                                                <td><span class="tv-rel">$!subRole</span></td>
                                                <td>$!subTarget.type.name</td>
                                                <td>$!subTarget.title</td>
                                                <td>$!subTarget.status.name</td>
                                            </tr>
                                        #end
                                    #end
                                #end
                            #end
                        </tbody>
                    </table>
                #end
            </div>
        #end
    #end
</div>
