<script type="text/javascript">
console.log("********************Script Start********************");
// Extract URL parameters client-side from window location hash or search
(function initTvParams() {
	console.log("********************initTvParams - Start********************");
    function runSync() {
        console.log("********************runSync - start********************");
        try {
            var href = window.top ? window.top.location.href : window.location.href;
            console.log("URL: ", href);
            var queryStr = "";
            if (href.indexOf('?') !== -1) {
                queryStr = href.substring(href.indexOf('?') + 1);
				console.log("queryStr?: ", queryStr);
                if (queryStr.indexOf('#') !== -1) {
                    queryStr = queryStr.substring(0, queryStr.indexOf('#'));
                    console.log("queryStr#: ", queryStr);
                }
            }
            var searchParams = new URLSearchParams(queryStr);
            var workItems = searchParams.get("WorkItems") || searchParams.get("reqId") || "";
            var title = searchParams.get("Title") || "";
            var depth = searchParams.get("Depth") || "6";
			console.log("searchParams: ", searchParams);
			console.log("workItems: ", workItems);
			console.log("title: ", title);
			console.log("depth: ", depth);

            window.addEventListener('DOMContentLoaded', function() {
                var inputWi = document.getElementById('tvReqInput');
                var inputTi = document.getElementById('tvTitleInput');
                var inputDe = document.getElementById('tvDepthInput');
				console.log("inputWi: ", inputWi);
				console.log("inputTi: ", inputTi);
				console.log("inputDe: ", inputDe);
                if (inputWi && workItems && !inputWi.value) { inputWi.value = workItems; }
                if (inputTi && title) { inputTi.value = title; }
                if (inputDe && depth) { inputDe.value = depth; }
				console.log("inputWi.value: ", inputWi.value);
				console.log("inputTi.value: ", inputTi.value);
				console.log("inputDe.value: ", inputDe.value);
            });
        }
        catch(err) {}
        console.log("********************runSync - End********************");
    }
    runSync();
    console.log("********************initTvParams - End********************");
})();

function tvApplyTrace(e) {
	console.log("****************tvApplyTrace - Start****************");
    if (e && e.preventDefault) { e.preventDefault(); }

    ##var inputWorkItems = document.getElementById('tvReqInput');
	var inputWorkItems = document.getElementById('tvReqInput');
    ##var inputTitle = document.getElementById('tvTitleInput');
    var inputDepth = document.getElementById('tvDepthInput');

    var valWorkItems = inputWorkItems.value.trim();
    if (!valWorkItems) {
		console.log("tvApplyTrace No work Items returning: false");
	return false;
    }

    ##var valTitle = inputTitle ? inputTitle.value.trim() : "Jaco";
    var valTitle = "$!titleUrlParam";
    var valDepth = inputDepth && inputDepth.value.trim() ? inputDepth.value.trim() : "6";

    console.log("Browser WorkItems: ", valWorkItems);
    console.log("Browser Title: ", valTitle);

    // Get current window or top location
    var targetWin = window;
    try {
        if (window.top && window.top.location && window.top.location.href) {
            targetWin = window.top;
        }
    } catch(err) {}

    var href = targetWin.location.href;

    // Clean any existing query params before '#' to prevent 'polarion/?WorkItems=...#/' format
    if (href.indexOf('?') !== -1 && href.indexOf('#') !== -1 && href.indexOf('?') < href.indexOf('#')) {
        var preHash = href.substring(0, href.indexOf('?'));
        var hashPart = href.substring(href.indexOf('#'));
        href = preHash + hashPart;
    }

    // Extract base URL before query parameters in hash part
    var baseHashRoute = href;
    if (baseHashRoute.indexOf('?') !== -1) {
        baseHashRoute = baseHashRoute.substring(0, baseHashRoute.indexOf('?'));
    }

    // Always construct complete query string with Title, WorkItems, and Depth
    var queryParams = "Title=" + encodeURIComponent(valTitle) +
                      "&WorkItems=" + encodeURIComponent(valWorkItems) +
                      "&Depth=" + encodeURIComponent(valDepth);

    href = baseHashRoute + "?" + queryParams;

    targetWin.location.href = href;
    console.log("URL baseHashRoute: ", baseHashRoute );
    console.log("URL queryParams: ", queryParams );
    console.log("URL: ", href );
	console.log("*****************tvApplyTrace - End*****************");
    return false;
}

function tvCopyUrl() {
	console.log("********************tvCopyUrl - Start********************");
    var el = document.getElementById('tvGeneratedUrlText');
    if (el) {
        navigator.clipboard.writeText(el.innerText || el.textContent);
        alert('Generated Trace URL copied to clipboard!');
    }
    console.log("********************tvCopyUrl - End********************");
}

console.log("********************Script End********************");
</script>

